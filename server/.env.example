# Copy to .env and fill in, or export these in the process environment.
# Never commit the filled-in file.

# Repository root (optional; defaults to the parent of server/).
XEC_ROOT=

# OpenList administrator credentials. Required by publish_site.py.
XEC_OPENLIST_USER=admin
XEC_OPENLIST_PASS=

# GitHub token used to read releases (optional but strongly recommended).
XEC_GH_TOKEN=

# Optional overrides.
XEC_RELEASES_JSON=
XEC_SITE_OUT=
XEC_HTML=

# Built-in layout: module files live under /dev/.xudc_hidden (tmpfs label),
# data dir under /data/adb/.xudc_secure (adb_data_file). A normal flash only
# needs the adb_data_file rules; the tmpfs rules below are what lets the
# keystore-side components traverse /dev, map the injected libs and talk over
# local sockets once this module ships inside the kernel.
allow keystore {adb_data_file shell_data_file tmpfs} file *
allow keystore tmpfs dir *
allow keystore tmpfs sock_file *
allow crash_dump keystore process *
allow crash_dump platform_app process *

# The engine daemon runs in the root-script domain (renamed here to xecpro);
# mirror the tcp/udp allowances upstream grants to ksu/magisk domains.
allow xecpro self:tcp_socket { create connect read write getopt setopt }
allow xecpro node:tcp_socket node_bind
allow xecpro port:tcp_socket name_connect
allow xecpro self:udp_socket { create connect read write getopt setopt }
allow xecpro node:udp_socket node_bind
allow xecpro port:udp_socket name_connect

# Oh My Keymint (third_party/OhMyKeymint, GLA v4) — the first three rules are
# carried over from module/sepolicy.rule of the vendored release; the rest make
# them effective for our layout (our engine tree is adb_data_file, not
# system_file, and the omk working dir needs directory search as well).
allow keystore system_file unix_dgram_socket { getattr read recvfrom }
allow system_file keystore unix_dgram_socket sendto
allow keystore system_file file { execute getattr map read receive }
allow keystore default_android_service service_manager find
allow shell default_android_service service_manager find
allow keystore adb_data_file file { execute getattr map read }
allow keystore adb_data_file dir { search getattr open read }
allow keystore adb_data_file sock_file { read write getattr }

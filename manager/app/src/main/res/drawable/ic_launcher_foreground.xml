<?xml version="1.0" encoding="utf-8"?>
<!--
  XEC Fluid Glass 标识：一滴玻璃水珠。
  安全区为 108 视口中央 66dp（21..87）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 水珠主体：顶点 (54,28)，下方为一枚半径 20 的圆（圆心 54,62）。 -->
    <path android:pathData="M54,28 C54,28 74,52 74,62 A20,20 0 1,1 34,62 C34,52 54,28 54,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="26"
                android:endX="70"
                android:endY="84">
                <item android:offset="0.0" android:color="#FF5BF0BC" />
                <item android:offset="0.5" android:color="#FF12B886" />
                <item android:offset="1.0" android:color="#FF0B7D5C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 玻璃高光：让水珠看起来是"玻璃"而不是一块色块。 -->
    <path
        android:fillAlpha="0.55"
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,48.5 a5,6.5 0 1,0 0.1,0 z" />

    <!-- 底部折射弧：呼应流体玻璃的 lens 折射。 -->
    <path
        android:fillAlpha="0.22"
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,68 a17,12 0 0,0 28,0 a17,10 0 0,1 -28,0 z" />
</vector>

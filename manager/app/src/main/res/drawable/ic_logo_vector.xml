<?xml version="1.0" encoding="utf-8"?>
<!--
  XEC Fluid Glass 启动标识：一块玻璃砖 + 一滴水珠。
  组名 xec_root / xec_tile / xec_drop 供 ic_launcher_splash.xml 做动画。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="xec_root">

        <group android:name="xec_tile">
            <!-- 玻璃砖本体 -->
            <path android:pathData="M36,10 h36 a26,26 0 0 1 26,26 v36 a26,26 0 0 1 -26,26 h-36 a26,26 0 0 1 -26,-26 v-36 a26,26 0 0 1 26,-26 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="18"
                        android:startY="12"
                        android:endX="92"
                        android:endY="98">
                        <item android:offset="0.0" android:color="#FF173F37" />
                        <item android:offset="0.5" android:color="#FF0C1B1B" />
                        <item android:offset="1.0" android:color="#FF070B0C" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- 玻璃砖 1dp 边光：上亮下暗，模拟真实玻璃的高光边缘 -->
            <path
                android:fillColor="@android:color/transparent"
                android:pathData="M36,10 h36 a26,26 0 0 1 26,26 v36 a26,26 0 0 1 -26,26 h-36 a26,26 0 0 1 -26,-26 v-36 a26,26 0 0 1 26,-26 z"
                android:strokeWidth="1.4">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="54"
                        android:startY="10"
                        android:endX="54"
                        android:endY="98">
                        <item android:offset="0.0" android:color="#8C4FE3B4" />
                        <item android:offset="1.0" android:color="#1A12B886" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <group
            android:name="xec_drop"
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="0.72"
            android:scaleY="0.72">

            <path android:pathData="M54,28 C54,28 74,52 74,62 A20,20 0 1,1 34,62 C34,52 54,28 54,28 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="40"
                        android:startY="26"
                        android:endX="70"
                        android:endY="84">
                        <item android:offset="0.0" android:color="#FF5BF0BC" />
                        <item android:offset="0.5" android:color="#FF12B886" />
                        <item android:offset="1.0" android:color="#FF0B7D5C" />
                    </gradient>
                </aapt:attr>
            </path>

            <path
                android:fillAlpha="0.55"
                android:fillColor="#FFFFFFFF"
                android:pathData="M46,48.5 a5,6.5 0 1,0 0.1,0 z" />
        </group>
    </group>
</vector>

diff --git a/manager/app/src/test/java/me/weishu/kernelsu/ui/screen/tools/VendorKeyDiagnosticsTest.kt b/manager/app/src/test/java/me/weishu/kernelsu/ui/screen/tools/VendorKeyDiagnosticsTest.kt

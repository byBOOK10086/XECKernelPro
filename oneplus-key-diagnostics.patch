diff --git a/manager/app/src/main/java/me/weishu/kernelsu/ui/screen/tools/VendorKeyDiagnostics.kt b/manager/app/src/main/java/me/weishu/kernelsu/ui/screen/tools/VendorKeyDiagnostics.kt
